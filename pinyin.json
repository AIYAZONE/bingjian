  "TONGGJIA": {
    "泄": "此处原作「洩」，同「泄」，疏导消散。「有余用洩」即有余则疏导。",
    "伉": "通「抗」，匹敌、相当。「伏亦不伉」即伏蛰时也不能抗衡。",
    "扬": "通「扬」，飞扬、振奋。「跳亦不扬」即跳动时也不能振奋。",
    "窕": "通「佻」，轻佻、不实。「尖舌无窕音」即发音不轻佻。",
    "傅": "通「敷」，涂抹。「白如傅粉」即白如涂了粉。",
    "赬": "读 chēng，赤红色。「赬尾守地阁」即赤红色守住下巴。"
  },
  "PHRASE": {
    "开门见山": ["kāi mén jiàn shān", "比喻直截了当，不绕弯子。此处指文人观人直取神骨根本。"],
    "澄清到底": ["chéng qīng dào dǐ", "精神清正透彻到极点。"],
    "收拾入门": ["shōu shí rù mén", "道家术语，指收敛精神、入于内观。"],
    "柱石器": ["zhù shí qì", "国家栋梁之才。柱石指支撑房屋的柱和基石。"],
    "先天种子": ["xiān tiān zhǒng zi", "与生俱来的气质禀赋，如种子般决定后天发展。"],
    "逆而合": ["nì ér hé", "五行逆向相合——如金合火、水合土。主贵非常。"],
    "相顾相称": ["xiāng gù xiāng chèn", "各部位相互照应、比例匀称。"],
    "科名星": ["kē míng xīng", "印堂眉尾处的光气，主早年功名。"],
    "阴骘纹": ["yīn zhì wén", "眼角处的纹路，主阴德与晚年发达。阴骘即暗中积德。"],
    "大家举止": ["dà jiā jǔ zhǐ", "有深厚教养的人的仪态风度。"],
    "文明气象": ["wén míng qì xiàng", "有一二层光彩的眉相——有文采修养之貌。"],
    "乘风翔舞": ["chéng fēng xiáng wǔ", "眉毛如乘风飞舞之势——眉之最佳形态。"],
    "闻声相思": ["wén shēng xiāng sī", "听到声音就能想见其人的模样——声音反映本质。"],
    "轻清为上": ["qīng qīng wéi shàng", "声音以轻清为最高品级。"],
    "国士": ["guó shì", "一国之中杰出的人才——不仅文雅而且厚重。"],
    "黄云盖顶": ["huáng yún gài dǐng", "黄色如云覆盖头顶——主大魁之相。"]
  }
